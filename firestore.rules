rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /test_cards/{cardId} {
      // Allow reading if the card is public or if the requester is the authenticated owner
      allow read: if resource.data.isPublic == true || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      // Allow creating only if authenticated and ownerId matches caller's UID
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Allow updating and deleting only by the authenticated document owner
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /test_card_versions/{versionId} {
      // Allow read if the card version is public or if the requester is the authenticated owner
      allow read: if resource.data.isPublic == true || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /experiments/{expId} {
      // Experiments contain evaluation runs, restricted strictly to the authenticated owner
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}

