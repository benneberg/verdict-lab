rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isGuest(data) {
      return data.ownerId == "guest_user";
    }

    function canAccess(data) {
      return isSignedIn() || isGuest(data);
    }

    match /test_cards/{cardId} {
      allow read: if true; // Allow reading public/guest cards
      allow create: if isSignedIn() ? request.auth.uid == request.resource.data.ownerId : isGuest(request.resource.data);
      allow update, delete: if isSignedIn() ? request.auth.uid == resource.data.ownerId : isGuest(resource.data);
    }

    match /experiments/{expId} {
      allow read: if true;
      allow create: if isSignedIn() ? request.auth.uid == request.resource.data.ownerId : isGuest(request.resource.data);
      allow update, delete: if isSignedIn() ? request.auth.uid == resource.data.ownerId : isGuest(resource.data);
    }
  }
}
